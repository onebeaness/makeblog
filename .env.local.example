# 수파베이스 대시보드 → Project Settings → API Keys 에서 복사한다.
#
# 둘 다 NEXT_PUBLIC_ 접두사가 붙어 있다 = 브라우저 번들에 그대로 들어간다.
# 그래도 되는 이유는 이 키가 "누구세요"를 말할 뿐 권한을 주지 않기 때문이다.
# 실제 방어선은 RLS 정책이다. 키를 숨기려 애쓰는 대신 RLS 를 검증하라.

# 반드시 https:// 로 시작하는 전체 주소. 프로젝트 ID 만 넣으면 안 된다.
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklm.supabase.co

# 공개용 키. 수파베이스가 키 체계를 바꾸는 중이라 두 형식이 있고, 둘 다 동작한다.
#   새 형식  sb_publishable_...    (Publishable key)
#   옛 형식  eyJhbGciOi...         (Legacy anon public — JWT)
# 대시보드에 보이는 쪽을 쓰면 된다. 단, URL 과 반드시 "같은 프로젝트"의 것이어야 한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# service_role / sb_secret_ 로 시작하는 키는 이 프로젝트에 넣지 않는다.
# 그 키는 RLS 를 통째로 우회하므로, 브라우저로 새어나가는 순간 DB 전체가 열린다.

# ---------------------------------------------------------------------------
# 리뷰 챗봇 (챕터 10) — 여기부터는 전부 서버 전용이다.
#
# NEXT_PUBLIC_ 접두사가 하나도 없다는 것을 보라. 이게 챕터 09 와 갈리는 지점이다.
# 수파베이스 anon key 는 RLS 가 지켜주므로 브라우저에 나가도 됐다.
# 아래 키들은 지켜줄 것이 없다 — 노출되면 남이 내 크레딧을 쓴다.
# 그래서 이 값을 만지는 코드는 전부 API Route(서버) 안에만 있다.
# ---------------------------------------------------------------------------

PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxx
PINECONE_INDEX=review-chatbot

# 임베딩 제공자: pinecone(기본) | ollama
#   pinecone — 무료 호스팅 임베딩. 설치할 것이 없고 배포 환경에서도 돈다.
#   ollama   — 로컬 GPU. 03절 모델 비교는 이쪽에서만 가능하다.
#              배포된 서버는 당신 PC 의 Ollama 에 접속할 수 없다.
EMBEDDING_PROVIDER=pinecone
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2

# EMBEDDING_PROVIDER=ollama 일 때만 쓰인다.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# 네임스페이스. 비워두면 임베딩 모델 이름에서 자동으로 만든다.
# 모델을 바꿨는데 네임스페이스를 안 바꾸면 좌표계가 섞여 검색이 망가진다.
# PINECONE_NAMESPACE=qwen

# 답변 생성 모델: anthropic(기본) | xai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=claude-opus-5
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxx

# 검색해서 LLM 에 넘길 리뷰 수.
RAG_TOP_K=5
