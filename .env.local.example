# 수파베이스 대시보드 → Project Settings → API Keys 에서 복사한다.
#
# 둘 다 NEXT_PUBLIC_ 접두사가 붙어 있다 = 브라우저 번들에 그대로 들어간다.
# 그래도 되는 이유는 이 키가 "누구세요"를 말할 뿐 권한을 주지 않기 때문이다.
# 실제 방어선은 RLS 정책이다. 키를 숨기려 애쓰는 대신 RLS 를 검증하라.

# 반드시 https:// 로 시작하는 전체 주소. 프로젝트 ID 만 넣으면 안 된다.
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklm.supabase.co

# 공개용 키. 수파베이스가 키 체계를 바꾸는 중이라 두 형식이 있고, 둘 다 동작한다.
#   새 형식  sb_publishable_...    (Publishable key)
#   옛 형식  eyJhbGciOi...         (Legacy anon public — JWT)
# 대시보드에 보이는 쪽을 쓰면 된다. 단, URL 과 반드시 "같은 프로젝트"의 것이어야 한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# service_role / sb_secret_ 로 시작하는 키는 이 프로젝트에 넣지 않는다.
# 그 키는 RLS 를 통째로 우회하므로, 브라우저로 새어나가는 순간 DB 전체가 열린다.
