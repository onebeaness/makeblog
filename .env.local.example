# 수파베이스 대시보드 → Project Settings → Data API 에서 복사한다.
#
# 둘 다 NEXT_PUBLIC_ 접두사가 붙어 있다 = 브라우저 번들에 그대로 들어간다.
# 그래도 되는 이유는 anon key 가 "누구세요"를 말할 뿐 권한을 주지 않기 때문이다.
# 실제 방어선은 RLS 정책이다. anon key 를 숨기려 애쓰는 대신 RLS 를 검증하라.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service_role 키는 이 프로젝트에 넣지 않는다.
# 그 키는 RLS 를 통째로 우회하므로, 브라우저로 새어나가는 순간 DB 전체가 열린다.
